{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docsgraph",
  "version": "0.0.0",
  "identifier": "com.docsgraph.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @docsgraph/web dev",
    "beforeBuildCommand": "pnpm --filter @docsgraph/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "docsgraph",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
